# Local-only secrets. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Replace with your project's actual RPM allowance.
GEMINI_RPM=5
# Research attempts per UTC day; in-memory and reset on restart.
MAX_DAILY_RESEARCH=20
# Local server defaults. Set production secrets in Vercel environment settings.
APP_ENV=development
# APP_ORIGIN=https://your-custom-domain.example
# HOST=127.0.0.1
# PORT=8765

# Ordered failover models. Empty disables failover. Attempts share the three-request budget.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# Salesforce OAuth integration (only needed to connect your CRM).
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
# Generate a long random value and keep it stable across deployments.
SESSION_SECRET=
