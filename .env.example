# Local-only secrets. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Replace with your project's actual RPM allowance.
GEMINI_RPM=5
# Optional locally; required (12+ characters) when APP_ENV=production or on Render.
ACCESS_USERNAME=reviewer
ACCESS_PASSWORD=
# Research attempts per UTC day; in-memory and reset on restart.
MAX_DAILY_RESEARCH=20
# Local defaults; Render supplies PORT and binds HOST=0.0.0.0 through render.yaml.
APP_ENV=development
# APP_ORIGIN=https://your-custom-domain.example
# HOST=127.0.0.1
# PORT=8765
